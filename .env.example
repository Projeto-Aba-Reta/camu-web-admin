# Supabase — preencha com as chaves do ambiente (local via `supabase start`
# ou projeto hospedado). Nunca commite `.env.local` com valores reais.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Porta do servidor Next.js (dev e start). Se mudar, atualize também
# site_url/additional_redirect_urls em supabase/config.toml e reinicie o
# Supabase local (`supabase stop && supabase start`) — o e-mail de convite
# usa essa URL para montar o link de aceite.
PORT=3000

# URL de um Incoming Webhook do Slack (Slack App > Incoming Webhooks >
# Add New Webhook to Workspace), no formato
# https://hooks.slack.com/services/T000/B000/XXXX. Usada para notificar a
# equipe quando um item da fila de impressão é concluído. Se deixada em
# branco, a notificação vira um no-op silencioso (apenas log de aviso).
SLACK_WEBHOOK_URL=

# OPCIONAL. Segredo compartilhado que protege POST/GET
# /api/cron/complete-print-queue — a rota que conclui automaticamente
# impressões cujo tempo estimado já esgotou (ver openspec/specs/fila-de-impressao,
# Requirement "Conclusão automática por tempo esgotado").
#
# Só preencha se houver um agendador externo chamando a rota. Nenhum vem
# configurado: o cron da Vercel exige plano Pro, então o repositório não declara
# `crons` em vercel.json (ver docs/deploy-dev.md, Parte 3, para as alternativas).
# Sem esse valor, a rota sempre responde 401 e a conclusão automática não roda —
# a conclusão manual pela UI continua funcionando normalmente, e no ambiente
# local o `make dev` já simula o job via `npm run dev:cron`.
#
# Se for ligar um agendador: gere um valor aleatório (ex.: `openssl rand -hex 32`)
# e configure o mesmo valor nele, como header `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
