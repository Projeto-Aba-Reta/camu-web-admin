# Supabase — preencha com as chaves do ambiente (local via `supabase start`
# ou projeto hospedado). Nunca commite `.env.local` com valores reais.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Porta do servidor Next.js (dev e start). Se mudar, atualize também
# site_url/additional_redirect_urls em supabase/config.toml e reinicie o
# Supabase local (`supabase stop && supabase start`) — o e-mail de convite
# usa essa URL para montar o link de aceite.
PORT=3000

# URL de um Incoming Webhook do Slack (Slack App > Incoming Webhooks >
# Add New Webhook to Workspace), no formato
# https://hooks.slack.com/services/T000/B000/XXXX. Usada para notificar a
# equipe quando um item da fila de impressão é concluído. Se deixada em
# branco, a notificação vira um no-op silencioso (apenas log de aviso).
SLACK_WEBHOOK_URL=

# Segredo compartilhado que protege POST/GET /api/cron/complete-print-queue
# — a rota que conclui automaticamente impressões cujo tempo estimado já
# esgotou (ver openspec/specs/fila-de-impressao, Requirement "Conclusão
# automática por tempo esgotado"). Gere um valor aleatório (ex.: `openssl
# rand -hex 32`) e configure o mesmo valor no agendador (Vercel Cron,
# GitHub Actions, etc.) como header `Authorization: Bearer <CRON_SECRET>`.
# Sem esse valor configurado, a rota sempre responde 401 e a conclusão
# automática não roda — a conclusão manual continua funcionando normalmente.
CRON_SECRET=
