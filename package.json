{
  "name": "camu-web-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "set -a; [ -f .env.local ] && . ./.env.local; set +a; next dev -p \"${PORT:-3000}\"",
    "build": "next build",
    "start": "set -a; [ -f .env.local ] && . ./.env.local; set +a; next start -p \"${PORT:-3000}\"",
    "lint": "eslint",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "db:migration:new": "supabase migration new",
    "seed-roles": "tsx --conditions=react-server scripts/seed-roles.ts",
    "seed-pricing": "tsx --conditions=react-server scripts/seed-pricing.ts",
    "seed-governance": "tsx --conditions=react-server scripts/seed-governance.ts",
    "seed-inventory": "tsx --conditions=react-server scripts/seed-inventory.ts",
    "seed-catalog": "tsx --conditions=react-server scripts/seed-catalog.ts",
    "seed-slicing-sheets": "tsx --conditions=react-server scripts/seed-slicing-sheets.ts",
    "seed-all": "npm run seed-roles && npm run seed-pricing && npm run seed-inventory && npm run seed-catalog && npm run seed-slicing-sheets && npm run seed-governance",
    "dev:cron": "tsx --conditions=react-server scripts/run-print-queue-cron.ts",
    "test": "vitest"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.81.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
